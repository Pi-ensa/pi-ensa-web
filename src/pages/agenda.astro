---
import source from '../content/paginas/horarios.md?raw';
import PageHero from '../components/common/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { scheduleSettings, workshopSchedule } from '../utils/workshop-schedule';
import { fields } from '../utils/markdown-data';

const page = fields(source, 'Página');
---

<BaseLayout title={page['título del navegador']} description={page['descripción seo']}>
  <PageHero eyebrow={page.etiqueta} title={page['título principal']} description={page['introducción']} />
  <section class="section">
    <div class="container">
      {scheduleSettings.showSchedule ? (
        <>
          <p class="mb-8 max-w-5xl text-lg">
            Todas las actividades de PI-ENSA de <strong>{scheduleSettings.period}</strong> serán ofrecidas en modo <strong>{scheduleSettings.modality}</strong> con una duración de <strong>{scheduleSettings.duration}</strong>.
          </p>
          <div class="schedule-table-wrapper">
            <table class="schedule-table">
              <thead>
                <tr>
                  <th scope="col">Taller</th>
                  <th scope="col">Horario</th>
                  <th scope="col">Salón</th>
                  <th scope="col">Fechas de inicio y término</th>
                  <th scope="col">Observaciones</th>
                </tr>
              </thead>
              <tbody>
                {workshopSchedule.map((schedule) => (
                  <tr>
                    <th scope="row">{schedule.workshop}</th>
                    <td>{schedule.time}</td>
                    <td>{schedule.room}</td>
                    <td>{schedule.dates}</td>
                    <td>{schedule.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {scheduleSettings.note && <p class="mt-8 text-sm text-[var(--muted)]">{scheduleSettings.note}</p>}
        </>
      ) : (
        <div class="notice"><strong>{scheduleSettings.alternateMessage}</strong></div>
      )}
    </div>
  </section>
</BaseLayout>
