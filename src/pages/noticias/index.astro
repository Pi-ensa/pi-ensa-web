---
import source from '../../content/paginas/noticias.md?raw';
import PageHero from '../../components/common/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fields, isEnabled, tableRows } from '../../utils/markdown-data';
import { withBase } from '../../utils/paths';

const page = fields(source, 'Página');
const entries = tableRows(source, 'Noticias publicadas')
  .filter((row) => row.length >= 6)
  .map(([date, title, description, link, popup, show]) => ({ date, title, description, link, popup, show }))
  .filter((entry) => entry.title && isEnabled(entry.show));
const galleryRows = tableRows(source, 'Galerías de noticias')
  .filter((row) => row.length >= 3)
  .map(([news, image, alt]) => ({ news, image, alt }))
  .filter((item) => item.news && item.image);
const isExternal = (link = '') => /^(https?:)?\/\//i.test(link);
const linkFor = (link = '') => isExternal(link) ? link : withBase(link);
const imageFor = (image = '') => isExternal(image) ? image : withBase(image);
---

<BaseLayout title={page['título del navegador']}>
  <PageHero eyebrow={page.etiqueta} title={page['título principal']} />
  <section class="section">
    <div class="container grid gap-6 md:grid-cols-2">
      {entries.map((entry, index) => {
        const dialogId = `noticia-popup-${index + 1}`;
        const gallery = galleryRows.filter((item) => item.news === entry.title);
        return (
          <>
            <article class="card flex flex-col">
              <p class="text-sm text-[var(--muted)]">{entry.date}</p>
              <h2 class="mt-2 text-2xl font-bold">
                {entry.link ? <a href={linkFor(entry.link)} target={isExternal(entry.link) ? '_blank' : undefined} rel={isExternal(entry.link) ? 'noopener noreferrer' : undefined}>{entry.title}</a> : entry.title}
              </h2>
              <p class="mt-3 flex-1">{entry.description}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                {entry.link && <a class="button secondary" href={linkFor(entry.link)} target={isExternal(entry.link) ? '_blank' : undefined} rel={isExternal(entry.link) ? 'noopener noreferrer' : undefined}>Leer más</a>}
                {entry.popup && <button class="button" type="button" data-open-dialog={dialogId} aria-haspopup="dialog">{entry.popup}</button>}
              </div>
            </article>

            {entry.popup && (
              <dialog id={dialogId} class="site-dialog" aria-labelledby={`${dialogId}-title`}>
                <div class="site-dialog-header">
                  <div>
                    <p class="eyebrow">{entry.popup}</p>
                    <h2 id={`${dialogId}-title`} class="mt-2 text-3xl font-bold">{entry.title}</h2>
                  </div>
                  <button class="site-dialog-close" type="button" data-close-dialog aria-label="Cerrar ventana">×</button>
                </div>
                <div class="site-dialog-content">
                  {gallery.length > 0 ? (
                    <div class="grid gap-5 sm:grid-cols-2">
                      {gallery.map((item) => <img class="w-full rounded-xl object-cover" src={imageFor(item.image)} alt={item.alt} loading="lazy" />)}
                    </div>
                  ) : (
                    <p class="notice">Las fotografías se publicarán próximamente.</p>
                  )}
                </div>
              </dialog>
            )}
          </>
        );
      })}
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach((button) => {
    button.addEventListener('click', () => document.querySelector<HTMLDialogElement>(`#${button.dataset.openDialog}`)?.showModal());
  });
  document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
    button.addEventListener('click', () => button.closest<HTMLDialogElement>('dialog')?.close());
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.site-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
