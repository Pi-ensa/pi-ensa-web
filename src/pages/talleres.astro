---
import source from '../content/paginas/inscribete.md?raw';
import PageHero from '../components/common/PageHero.astro';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, tableRows } from '../utils/markdown-data';
import { participantFormUrl, registrationBanner, workshopOffer } from '../utils/workshop-offer';
import { withBase } from '../utils/paths';

const page = fields(source, 'Página');
const registrationInformation = fields(source, 'Información de inscripción');
const registrationRequirements = tableRows(source, 'Requisitos de registro').filter(([number, requirement]) => number && requirement);
const registrationSteps = tableRows(source, 'Pasos del registro')
  .filter((row) => row.length >= 5)
  .map(([step, highlight, description, button, link]) => ({ step, highlight, description, button, link }))
  .filter((step) => step.step && step.description);
const participants = fields(source, 'Participantes');
const registration = participantFormUrl || `mailto:${SITE.contactEmail}?subject=Inscripción a talleres PI-ENSA`;
---

<BaseLayout title={page['título del navegador']} description={page['descripción seo']}>
  <PageHero eyebrow={page.etiqueta} title={page['título principal']} description={page['introducción']} />

  <section class="section">
    <div class="container">
      <aside class="rounded-3xl border border-white/20 bg-[var(--primary)] p-6 text-white shadow-lg md:p-8" aria-labelledby="registration-status">
        <h2 id="registration-status" class="text-3xl font-extrabold">{registrationBanner.status}</h2>
        <div class="mt-5 grid gap-3 md:grid-cols-2">
          <p class="rounded-2xl bg-white/10 p-4"><strong>Inscripciones:</strong><br />{registrationBanner.registrationDates}</p>
          <p class="rounded-2xl bg-white/10 p-4"><strong>Inscripciones extemporáneas:</strong><br />{registrationBanner.lateRegistration}</p>
        </div>
      </aside>

      <section class="mt-12" aria-labelledby="registration-information">
        <h2 id="registration-information" class="text-3xl font-extrabold md:text-4xl">{registrationInformation['título']}</h2>
        <p class="lead mt-5">{registrationInformation['introducción']}</p>

        <h3 class="mt-10 text-2xl font-bold">{registrationInformation['título requisitos']}</h3>
        <ol class="mt-5 grid gap-4">
          {registrationRequirements.map(([number, requirement]) => (
            <li class="card flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--primary)] font-extrabold text-white">{number}</span>
              <p>{requirement}</p>
            </li>
          ))}
        </ol>

        <h3 class="mt-12 text-2xl font-bold">{registrationInformation['título pasos']}</h3>
        <ol class="mt-5 grid gap-4">
          {registrationSteps.map((step) => (
            <li class="card flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--accent)] font-extrabold text-white">{step.step}</span>
              <div>
                <p>
                  {step.highlight && <strong class="font-extrabold underline underline-offset-4">{step.highlight}: </strong>}
                  {step.description}
                </p>
                {step.button && (
                  <a
                    class="button mt-5"
                    href={step.link || registration}
                    target={step.link?.startsWith('http') || participantFormUrl ? '_blank' : undefined}
                    rel={step.link?.startsWith('http') || participantFormUrl ? 'noopener noreferrer' : undefined}
                  >{step.button}</a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <article class="card card-link mt-8 flex flex-col">
        <p class="eyebrow">{participants.etiqueta}</p>
        <h2 class="mt-3 text-2xl font-bold">{participants['título']}</h2>
        <p class="max-w-3xl flex-1">{participants.texto}</p>
        <a
          class="button mt-6"
          href={registration}
          target={participantFormUrl ? '_blank' : undefined}
          rel={participantFormUrl ? 'noopener noreferrer' : undefined}
        >{participants['botón']}</a>
      </article>
      {!participantFormUrl && <p class="mt-4 text-center text-sm text-[var(--muted)]">{participants['nota sin formulario']}</p>}

      {workshopOffer.length > 0 && (
        <section class="mt-14" aria-labelledby="current-offer">
          <h2 id="current-offer" class="text-3xl font-extrabold">Talleres ofertados {registrationBanner.workshopPeriod}</h2>
          <div class="mt-7 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {workshopOffer.map((workshop) => (
              <article class="card card-link flex flex-col">
                <h3 class="text-2xl font-bold">{workshop.name}</h3>
                <p class="mt-3 flex-1 text-[var(--muted)]">{workshop.description}</p>
                <a class="button mt-6" href={withBase(workshop.posterPdf)} target="_blank" rel="noopener noreferrer">
                  Ver cartel en PDF <span class="sr-only">(abre en otra pestaña)</span>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</BaseLayout>
