---
import source from '../content/paginas/impacto.md?raw';
import PageHero from '../components/common/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, tableRows } from '../utils/markdown-data';

const page = fields(source, 'Página');
const indicators = tableRows(source, 'Indicadores');
const content = tableRows(source, 'Contenido').map(([column, order, title, text]) => ({ column, order, title, text }));
const columns = ['1', '2'].map((column) => content.filter((item) => item.column === column).sort((a, b) => Number(a.order) - Number(b.order)));
---

<BaseLayout title={page['título']} description={page['descripción seo']}>
  <PageHero eyebrow={page.etiqueta} title={page['título principal']} description={page['introducción']} />

  <section class="section">
    <div class="container">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {indicators.map(([number, description]) => (
          <article class="card">
            <p class="text-4xl font-extrabold text-[var(--primary)]">{number}</p>
            <p>{description}</p>
          </article>
        ))}
      </div>

      <p class="mt-5 text-sm text-[var(--muted)]">{page['nota de indicadores']}</p>

      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        {columns.map((items) => (
          <article class="prose">
            {items.map((item) => <><h2>{item.title}</h2><p>{item.text}</p></>)}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
