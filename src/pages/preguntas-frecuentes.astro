---
import source from '../content/paginas/preguntas-frecuentes.md?raw';
import PageHero from '../components/common/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, tableRows } from '../utils/markdown-data';

const page = fields(source, 'Página');
const faqs = tableRows(source, 'Preguntas').map(([question, answer]) => ({ question, answer }));
---

<BaseLayout title={page['título']}>
  <PageHero title={page['título principal']} />
  <section class="section">
    <div class="container max-w-4xl">
      {faqs.map((item) => (
        <details class="mb-4 rounded-xl border border-[var(--border)] bg-white p-5">
          <summary class="cursor-pointer text-lg font-bold">{item.question}</summary>
          <p class="mt-3 text-[var(--muted)]">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
