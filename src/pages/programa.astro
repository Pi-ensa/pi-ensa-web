---
import source from '../content/paginas/quienes-somos.md?raw';
import PageHero from '../components/common/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, sectionClass, tableRows } from '../utils/markdown-data';
import { withBase } from '../utils/paths';

const page = fields(source, 'Página');
const presentation = tableRows(source, 'Presentación');
const keyDates = fields(source, 'Fechas clave');
const timeline = tableRows(source, 'Cronología');
const coordination = fields(source, 'Coordinación académica');
---

<BaseLayout title={page['título del navegador']} description={page['descripción seo']}>
  <PageHero eyebrow={page.etiqueta} title={page['título principal']} description={page['introducción']} />

  <section class="section">
    <div class="container grid gap-10 lg:grid-cols-[1fr_.8fr]">
      <article class="prose">
        {presentation.map(([title, text]) => <><h2>{title}</h2><p>{text}</p></>)}
      </article>
      <aside class="card self-start">
        <p class="eyebrow">{keyDates.etiqueta}</p>
        <ol class="mt-5 space-y-5">
          {timeline.map(([year, description]) => <li><strong>{year}</strong><br />{description}</li>)}
        </ol>
        <a class="button mt-6" href={withBase(keyDates.ruta)}>{keyDates['botón']}</a>
      </aside>
    </div>
  </section>

  <section class={sectionClass(coordination['diseño'], 'Claro')}>
    <div class="container">
      <p class="eyebrow">{coordination.etiqueta}</p>
      <h2 class="mt-3 text-3xl font-extrabold">{coordination['título']}</h2>
      <div class="lead mt-4 space-y-4">
        <p>{coordination['párrafo 1']}</p>
        <p>{coordination['párrafo 2']}</p>
      </div>
    </div>
  </section>
</BaseLayout>
