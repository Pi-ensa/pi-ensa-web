---
import source from '../content/paginas/inicio.md?raw';
import noticeSource from '../content/paginas/aviso-general.md?raw';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, isEnabled, sectionClass, tableRows } from '../utils/markdown-data';
import { withBase } from '../utils/paths';

const page = fields(source, 'Página');
const hero = fields(source, 'Presentación');
const heroButtons = tableRows(source, 'Botones de presentación');
const service = fields(source, 'Servicio social');
const about = fields(source, 'Qué es PI-ENSA');
const workshops = fields(source, 'Talleres');
const thematicAreas = tableRows(source, 'Áreas').map(([name, description]) => ({ name, description }));
const offer = fields(source, 'Oferta destacada');
const generalNotice = fields(noticeSource, 'Publicación');
const showGeneralNotice = isEnabled(generalNotice.mostrar);
const serviceIsBlue = service['diseño'].toLocaleLowerCase('es') === 'azul';
const offerIsBlue = offer['diseño'].toLocaleLowerCase('es') === 'azul';
const noticeLinkIsExternal = /^(https?:)?\/\//i.test(generalNotice.enlace || '');
const noticeLink = noticeLinkIsExternal ? generalNotice.enlace : withBase(generalNotice.enlace);
---

<BaseLayout title={page['título del navegador']}>
  <section class={sectionClass(hero['diseño'], 'Principal')}>
    <div class="container grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="eyebrow">{hero.etiqueta}</p>
        <h1 class="display mt-4 font-extrabold">{hero['título']}</h1>
        <p class="lead mt-6">{hero.texto}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {heroButtons.map(([text, path, style]) => (
            <a class:list={['button', { secondary: style.toLocaleLowerCase('es') === 'secundario' }]} href={withBase(path)}>{text}</a>
          ))}
        </div>
      </div>
      <figure>
        <img src={withBase(hero.imagen)} width="1100" height="820" alt={hero['texto alternativo']} class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-2xl" />
        <figcaption class="mt-3 text-sm text-[var(--muted)]">{hero['pie de imagen']}</figcaption>
      </figure>
    </div>
  </section>

  <section class={sectionClass(service['diseño'], 'Azul')}>
    <div class="container grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class:list={['eyebrow', { '!text-blue-200': serviceIsBlue }]}>{service.etiqueta}</p>
        <h2 class="mt-3 text-3xl font-extrabold">{service['título']}</h2>
        <p class:list={['mt-3 max-w-2xl', serviceIsBlue ? 'text-blue-100' : 'text-[var(--muted)]']}>{service.texto}</p>
      </div>
      <a class:list={['button', { 'on-dark': serviceIsBlue }]} href={withBase(service.ruta)}>{service['botón']}</a>
    </div>
  </section>

  <section class={sectionClass(about['diseño'], 'Claro')}>
    <div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="eyebrow">{about.etiqueta}</p>
        <h2 class="mt-3 text-3xl font-extrabold md:text-4xl">{about['título']}</h2>
      </div>
      <div class="lead">
        <p>{about['párrafo 1']}</p>
        <p>{about['párrafo 2']}</p>
      </div>
    </div>
  </section>

  <section class={sectionClass(workshops['diseño'], 'Blanco')}>
    <div class="container">
      <h2 class="max-w-2xl text-3xl font-extrabold md:text-4xl">{workshops['título']}</h2>
      <div class="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {thematicAreas.map((area) => (
          <article class="card">
            <h3 class="text-xl font-bold text-[var(--primary)]">{area.name}</h3>
            <p class="mt-2 text-[var(--muted)]">{area.description}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-sm text-[var(--muted)]">{workshops.nota}</p>
    </div>
  </section>

  <section class={sectionClass(offer['diseño'], 'Azul')}>
    <div class="container grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class:list={['eyebrow', { '!text-blue-200': offerIsBlue }]}>{offer.etiqueta}</p>
        <h2 class="mt-3 text-3xl font-extrabold">{offer['título']}</h2>
        <p class:list={['mt-3 max-w-2xl', offerIsBlue ? 'text-blue-100' : 'text-[var(--muted)]']}>{offer.texto}</p>
      </div>
      <a class:list={['button', { 'on-dark': offerIsBlue }]} href={withBase(offer.ruta)}>{offer['botón']}</a>
    </div>
  </section>

  {showGeneralNotice && (
    <dialog id="general-notice-dialog" class="site-dialog site-dialog-small" aria-labelledby="general-notice-title">
      <div class="site-dialog-header">
        <div>
          <p class="eyebrow">{generalNotice.etiqueta}</p>
          <h2 id="general-notice-title" class="mt-2 text-3xl font-bold">{generalNotice['título']}</h2>
        </div>
        <button class="site-dialog-close" type="button" data-close-general-notice aria-label="Cerrar aviso">×</button>
      </div>
      <div class="site-dialog-content">
        <p class="lead">{generalNotice.mensaje}</p>
        {generalNotice['botón'] && generalNotice.enlace && (
          <a class="button mt-6" href={noticeLink} target={noticeLinkIsExternal ? '_blank' : undefined} rel={noticeLinkIsExternal ? 'noopener noreferrer' : undefined}>{generalNotice['botón']}</a>
        )}
      </div>
    </dialog>
  )}
</BaseLayout>

<script>
  const generalNoticeDialog = document.querySelector<HTMLDialogElement>('#general-notice-dialog');
  if (generalNoticeDialog) requestAnimationFrame(() => generalNoticeDialog.showModal());
  document.querySelector<HTMLButtonElement>('[data-close-general-notice]')?.addEventListener('click', () => generalNoticeDialog?.close());
  generalNoticeDialog?.addEventListener('click', (event) => {
    if (event.target === generalNoticeDialog) generalNoticeDialog.close();
  });
</script>
