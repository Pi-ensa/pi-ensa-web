---
import source from '../content/paginas/contacto.md?raw';
import PageHero from '../components/common/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, tableRows } from '../utils/markdown-data';
import { visibleContactChannels as channels } from '../utils/contact-channels';

const page = fields(source, 'Página');
const questions = tableRows(source, 'Preguntas frecuentes').filter(([question, answer]) => question && answer);
const opensNewTab = (link = '') => /^https?:\/\//i.test(link);
---

<BaseLayout title={page['título del navegador']}>
  <PageHero eyebrow={page.etiqueta} title={page['título principal']} description={page['introducción']} />
  <section class="section bg-[var(--surface)]">
    <div class="container max-w-4xl">
      <h2 class="text-3xl font-extrabold md:text-4xl">{page['título preguntas frecuentes']}</h2>
      <div class="mt-8 grid gap-4">
        {questions.map(([question, answer]) => (
          <details class="card group">
            <summary class="cursor-pointer text-xl font-bold text-[var(--primary)]">{question}</summary>
            <p class="mt-4 text-[var(--muted)]">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">{page['etiqueta canales']}</p>
      <h2 class="mt-3 text-3xl font-extrabold md:text-4xl">{page['título canales']}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {channels.map((channel) => (
          <article class="card">
            <p class="eyebrow">{channel.label}</p>
            <h3 class="mt-3 text-2xl font-bold">{channel.title}</h3>
            <a class="button mt-4" href={channel.link} target={opensNewTab(channel.link) ? '_blank' : undefined} rel={opensNewTab(channel.link) ? 'noopener noreferrer' : undefined}>
              {channel.linkText}{opensNewTab(channel.link) && <span class="sr-only"> (abre en otra pestaña)</span>}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
