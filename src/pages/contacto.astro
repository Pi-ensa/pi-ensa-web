---
import source from '../content/paginas/contacto.md?raw';
import PageHero from '../components/common/PageHero.astro';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fields, tableRows } from '../utils/markdown-data';

const page = fields(source, 'Página');
const channels = tableRows(source, 'Canales');
---

<BaseLayout title={page['título']}>
  <PageHero title={page['título principal']} description={page['introducción']} />
  <section class="section">
    <div class="container grid gap-6 md:grid-cols-2">
      {channels.map(([type, label, title, linkText]) => (
        <article class="card">
          <p class="eyebrow">{label}</p>
          <h2 class="mt-3 text-2xl font-bold">{title}</h2>
          {type.toLocaleLowerCase('es') === 'correo' ? (
            <a class="mt-4 inline-block text-lg font-semibold text-[var(--primary)]" href={`mailto:${SITE.contactEmail}`}>{linkText}</a>
          ) : (
            <a class="button mt-4" href={SITE.socialLinks.facebook} target="_blank" rel="noopener noreferrer">{linkText} <span class="sr-only">(abre en otra pestaña)</span></a>
          )}
        </article>
      ))}
      <p class="notice mt-8">{page.aviso}</p>
    </div>
  </section>
</BaseLayout>
